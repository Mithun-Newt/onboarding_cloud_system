# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/school_admissions"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-to-a-random-secret-min-32-chars"

# File storage
UPLOAD_DIR="./storage/uploads"
MAX_FILE_SIZE_MB=10

# App
NEXT_PUBLIC_APP_NAME="Junior School Admissions System"
NEXT_PUBLIC_SCHOOL_NAME="Your School Name"
