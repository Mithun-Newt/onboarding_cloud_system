# =============================================================================
# Junior School Admissions System — Environment Configuration
# =============================================================================
#
# HOW TO USE THIS FILE
# --------------------
# 1. Copy this file to .env in the same folder:
#       Windows:  copy .env.example .env
#       Mac/Linux: cp .env.example .env
#
# 2. Fill in every value marked <REQUIRED> below.
#
# 3. Never commit .env to git — it contains secrets.
# =============================================================================


# =============================================================================
# DATABASE  <REQUIRED>
# =============================================================================
#
# PostgreSQL connection string.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
#
# If PostgreSQL is installed locally with default settings:
#   - user     : postgres
#   - password : whatever you set during PostgreSQL installation
#   - host     : localhost
#   - port     : 5432
#   - database : school_admissions  (create this first — see SETUP below)
#
# SETUP (run once in psql or pgAdmin):
#   CREATE DATABASE school_admissions;
#
# Then initialise the schema + seed data:
#   psql -U postgres -d school_admissions -f database\init.sql
#
DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/school_admissions"


# =============================================================================
# NEXTAUTH  <REQUIRED>
# =============================================================================
#
# NEXTAUTH_URL  — the URL browsers use to reach the app.
#   Local only   : http://localhost:3000
#   LAN access   : http://192.168.X.X:3000  (use your machine's IP from ipconfig)
#
NEXTAUTH_URL="http://localhost:3000"

# NEXTAUTH_SECRET — random secret, minimum 32 characters.
# Generate one by running this command in a terminal:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Then paste the output below.
#
NEXTAUTH_SECRET="REPLACE_WITH_OUTPUT_OF_THE_NODE_COMMAND_ABOVE"


# =============================================================================
# FILE UPLOADS  (optional — defaults shown)
# =============================================================================

# Folder where uploaded documents are stored.
UPLOAD_DIR="./storage/uploads"

# Maximum allowed upload size in megabytes.
MAX_FILE_SIZE_MB=10


# =============================================================================
# BRANDING  (optional — change to your school's name)
# =============================================================================

NEXT_PUBLIC_APP_NAME="Junior School Admissions System"
NEXT_PUBLIC_SCHOOL_NAME="Your School Name"
